[Unit]
Description=Key Sort morphology API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vershalovskiy.com/key-sort
Environment=KEY_SORT_HOST=127.0.0.1
Environment=KEY_SORT_PORT=8815
ExecStart=/opt/vershalovskiy.com/key-sort/.venv/bin/python /opt/vershalovskiy.com/key-sort/app.py
Restart=on-failure
RestartSec=3
MemoryMax=256M
CPUQuota=100%
TasksMax=32
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
