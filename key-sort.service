[Unit]
Description=Key Sort morphology API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vershalovskiy.com/key-sort
ExecStart=/opt/vershalovskiy.com/key-sort/.venv/bin/python /opt/vershalovskiy.com/key-sort/app.py
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
