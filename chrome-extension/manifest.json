{
  "manifest_version": 3,
  "name": "Key Sort — API Яндекса",
  "version": "1.0.3",
  "description": "Локально хранит ключи и выполняет запросы Wordstat и Яндекс Директа для Key Sort.",
  "icons": { "16": "favicon.ico" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://searchapi.api.cloud.yandex.net/*",
    "https://api.direct.yandex.ru/*",
    "https://oauth.yandex.ru/verification_code*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://key-sort.vershalovskiy.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://oauth.yandex.ru/verification_code*"],
      "js": ["oauth-callback.js"],
      "run_at": "document_end"
    }
  ]
}
