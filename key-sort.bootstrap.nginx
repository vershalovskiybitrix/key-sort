server {
    listen 80;
    listen [::]:80;
    server_name key-sort.vershalovskiy.com;

    root /opt/vershalovskiy.com/key-sort;
    index index.html;
    charset utf-8;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" always;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location = / { try_files /index.html =404; }
    location = /index.html { try_files /index.html =404; }
    location ~ ^/(?:help|services|keyword-parser|budget-forecast|text-format|subtract|multiplier)\.html$ { try_files $uri =404; }
    location ~ ^/assets/(?:app\.(?:css|js)|services(?:-common)?\.(?:css|js)|keyword-parser\.js|budget-forecast\.js|text-format\.js|subtract\.js|multiplier\.js|vcg-logo\.png|fonts/(?:SourceCodePro|RobotoMono)\.ttf)$ {
        try_files $uri =404;
    }
    location / { return 404; }
}
